t: PDAM. Deskripsi: Isi ulang pulsa dan kuota air PDAM harian\",\n          \"Merchant: Chatime. Deskripsi: Beli bakso urat di Chatime bareng teman\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Jumlah_Rp\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 504710,\n        \"min\": 131000,\n        \"max\": 1312000,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          131000,\n          195000,\n          136000\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"code","source":["# FEATURE EXTRACTION MENGGUNAKAN INDOBERT BASE\n","import numpy as np\n","import torch\n","from sklearn.preprocessing import StandardScaler\n","from transformers import AutoModel, AutoTokenizer\n","\n","MODEL_NAME = \"indobenchmark/indobert-base-p1\"\n","\n","# Tokenizer & Model\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n","bert_model = AutoModel.from_pretrained(MODEL_NAME)\n","\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","bert_model.to(device)\n","bert_model.eval()\n","\n","\n","# MEAN POOLING\n","def mean_pooling(model_output, attention_mask):\n","    token_embeddings = model_output.last_hidden_state\n","    input_mask_expanded = (\n","        attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()\n","    )\n","    return torch.sum(\n","        token_embeddings * input_mask_expanded, dim=1\n","    ) / torch.clamp(input_mask_expanded.sum(dim=1), min=1e-9)\n","\n","\n","# EXTRACT EMBEDDINGS\n","def extract_embeddings(texts, batch_size=32):\n","    embeddings = []\n","    for i in range(0, len(texts), batch_size):\n","        batch = texts.iloc[i : i + batch_size].astype(str).tolist()\n","        encoded = tokenizer(\n","            batch,\n","            padding=True,\n","            truncation=True,\n","            max_length=128,\n","            return_tensors=\"pt\",\n","        )\n","        encoded = {k: v.to(device) for k, v in encoded.items()}\n","        with torch.no_grad():\n","            outputs = bert_model(**encoded)\n","            sentence_embeddings = mean_pooling(outputs, encoded[\"attention_mask\"])\n","        embeddings.append(sentence_embeddings.cpu().numpy())\n","    return np.vstack(embeddings)\n","\n","\n","# 1. Ekstraksi Embedding Teks (Hanya passing kolom 'Teks')\n","X_train_emb = extract_embeddings(X_train[\"Teks\"])\n","X_test_emb = extract_embeddings(X_test[\"Teks\"])\n","\n","# 2. Scaling Fitur Numerik (Jumlah_Rp)\n","scaler = StandardScaler()\n","X_train_num = scaler.fit_transform(X_train[[\"Jumlah_Rp\"]])\n","X_test_num = scaler.transform(X_test[[\"Jumlah_Rp\"]])\n","\n","# 3. Gabungkan Embedding IndoBERT (768 dimensi) + Fitur Numerik (1 dimensi)\n","X_train_features = np.hstack((X_train_emb, X_train_num))\n","X_test_features = np.hstack((X_test_emb, X_test_num))\n","\n","print(\"=\" * 50)\n","print(\"HASIL FEATURE EXTRACTION INDOBERT + NUMERIK\")\n","print(\"=\" * 50)\n","print(\"X_train features shape :\", X_train_features.shape)  # Akan menjadi (N, 769)\n","print(\"X_test features shape  :\", X_test_features.shape)  # Akan menjadi (N, 769)"],"metadata":{"id":"H5rEPeGMUhqX","executionInfo":{"status":"ok","timestamp":1784994608942,"user_tz":-420,"elapsed":7805,"user":{"displayName":"OGIK KODING","userId":"13433047210437248029"}},"colab":{"base_uri":"https://localhost:8080/","height":136,"referenced_widgets":["1717dccdf61540f6817144186e717fd5","99e9723a15ce400d89520f561a13d502","e626af67e95d4da4988a6e2ad9a09e22","e390fabd489a4863b7e16bbd37bd0e9e","c9ef5d588fd342629f81ba6f6d890c3f","c004cf4541bd4abaa5e4e9e986c5660b","bfa74cc9257b41c59ab06bf629306f76","5216efba5dd84d9a95ae7a82d480f8dd","310ba29ffe5a409284fd68c27a03784d","23576a9b9170406c91b8d41f08a04ba6","cf392031858547079b2b79ef7c2bb7ea"]},"outputId":"4223bc42-97ca-4382-c4db-8ea7b335439c"},"execution_coun