}\")\n","print(f\"Precision (Macro) : {precision_macro:.4f}\")\n","print(f\"Recall (Macro)    : {recall_macro:.4f}\")\n","print(f\"F1-Score (Macro)  : {f1_macro:.4f}\")\n","print(f\"ROC-AUC (Macro)   : {roc_auc_macro:.4f}\")\n","\n","# Overfitting Check\n","if gap < 0.05:\n","    print(\n","        \"\\nModel memiliki kemampuan generalisasi yang baik (tidak overfitting).\"\n","    )\n","elif gap < 0.10:\n","    print(\"\\nModel menunjukkan indikasi overfitting ringan.\")\n","else:\n","    print(\"\\nModel mengalami overfitting.\")\n","\n","# Classification Report\n","print(\"\\n\" + \"=\" * 60)\n","print(\"CLASSIFICATION REPORT\")\n","print(\"=\" * 60)\n","print(\n","    classification_report(\n","        y_test, y_pred, target_names=encoder_kategori.classes_\n","    )\n",")\n","\n","# Confusion Matrix\n","cm = confusion_matrix(y_test, y_pred)\n","fig, ax = plt.subplots(figsize=(8, 6))\n","disp = ConfusionMatrixDisplay(\n","    confusion_matrix=cm, display_labels=encoder_kategori.classes_\n",")\n","disp.plot(cmap=\"Blues\", values_format=\"d\", ax=ax)\n","plt.title(\"Confusion Matrix - XGBoost\")\n","plt.xticks(rotation=45)\n","plt.yticks(rotation=0)\n","plt.tight_layout()\n","plt.show()"],"metadata":{"id":"MboSuMcjVuE4","executionInfo":{"status":"ok","timestamp":1784994757244,"user_tz":-420,"elapsed":766,"user":{"displayName":"OGIK KODING","userId":"13433047210437248029"}},"colab":{"base_uri":"https://localhost:8080/","height":1000},"outputId":"a0dec704-aed4-4e09-cd76-1ac197f3a4c3"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["============================================================\n","HASIL EVALUASI MODEL XGBOOST (MACRO METRICS)\n","============================================================\n","Train Accuracy : 1.0000\n","Test Accuracy  : 0.9990\n","Accuracy Gap   : 0.0010\n","Precision (Macro) : 0.9995\n","Recall (Macro)    : 0.9975\n","F1-Score (Macro)  : 0.9985\n","ROC-AUC (Macro)   : 1.0000\n","\n","Model memiliki k