-UNXwUDix","executionInfo":{"status":"ok","timestamp":1783760268604,"user_tz":-420,"elapsed":52,"user":{"displayName":"OGIK KODING","userId":"13433047210437248029"}},"colab":{"base_uri":"https://localhost:8080/","height":536},"outputId":"0616ff6b-7cae-4df5-ca66-ff2068315ebc"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["============================================================\n","MODEL 2 : KLASIFIKASI JENIS\n","============================================================\n","Jumlah Data  : 5544\n","Jumlah Kelas : 2\n","\n","Shape Dataset\n","X Train : (4435,)\n","X Test  : (1109,)\n","y Train : (4435,)\n","y Test  : (1109,)\n","\n","Daftar Label\n","0 -> Pemasukan\n","1 -> Pengeluaran\n","\n","Contoh Input IndoBERT\n"]},{"output_type":"display_data","data":{"text/plain":["5341    Kategori: Gaji. Merchant: Freelancer. Deskrips...\n","5496    Kategori: Gaji. Merchant: Bank CIMB Niaga. Des...\n","238     Kategori: Pendidikan. Merchant: Gramedia. Desk...\n","2962    Kategori: Pendidikan. Merchant: Universitas. D...\n","5051    Kategori: Gaji. Merchant: OVO. Deskripsi: Inse...\n","Name: Teks, dtype: object"],"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Teks</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>5341</th>\n","      <td>Kategori: Gaji. Merchant: Freelancer. Deskrips...</td>\n","    </tr>\n","    <tr>\n","      <th>5496</th>\n","      <td>Kategori: Gaji. Merchant: Bank CIMB Niaga. Des...</td>\n","    </tr>\n","    <tr>\n","      <th>238</th>\n","      <td>Kategori: Pendidikan. Merchant: Gramedia. Desk...</td>\n",