_train)\n","X_test_features = extract_embeddings(X_test)\n","\n","print(\"HASIL FEATURE EXTRACTION INDOBERT BASE\")\n","print(f\"X_train : {X_train_features.shape}\")\n","print(f\"X_test  : {X_test_features.shape}\")"],"metadata":{"id":"_NgTmPJqIGR3","executionInfo":{"status":"ok","timestamp":1783760312246,"user_tz":-420,"elapsed":15207,"user":{"displayName":"OGIK KODING","userId":"13433047210437248029"}},"colab":{"base_uri":"https://localhost:8080/","height":101,"referenced_widgets":["ccdeee6e62b0491789625efdd4ffb6c6","ccb0fdfa90a8447fbedb6ee3e101bf3a","5c7a6331350a446c908d16c5376b6324","1bce4e43c18949ccaa9c12825a391d50","fd796aba55f94126a082e775e4afb494","3f2e1a4d8c1c4d25b1dfb52a174eab71","03c0a9e7089446bab2779f75995aab38","a307d247406849878031a57948c9e6af","143ecf2df2ec41c29ba475f4b5c3ff63","f3890adb710e45bdb61d65ee589619b9","76d238071c7f4a7aab9b6d82498381f7"]},"outputId":"0a692773-8913-4207-a72d-c74dbce3292c"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ccdeee6e62b0491789625efdd4ffb6c6"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["HASIL FEATURE EXTRACTION INDOBERT BASE\n","X_train : (4435, 768)\n","X_test  : (1109, 768)\n"]}]},{"cell_type":"code","source":["# TRAINING XGBOOST - MODEL TRANSAKSI\n","from xgboost import XGBClassifier\n","\n","xgb_model = XGBClassifier(\n","    objective=\"binary:logistic\",\n","    n_estimators=350,\n","    learning_rate=0.04,\n","    max_depth=5,\n","    min_child_weight=2,\n","    subsample=0.8,\n","    colsample_bytree=0.8,\n","    reg_alpha=0.1,\n","    reg_lambda=1.5,\n","    random_state=42,\n","    eval_metric=\"logloss\",\n","    tree_method=\"hist\"\n",")\n","xgb_model.fit(\n","    X_train_features,\n","    y_train,\n","    eval_set=[\n","        (X_train_features, y_train),\n","        (X_test_features, y_test)