    with torch.no_grad():\n","            outputs = bert_model(**encoded)\n","            sentence_embeddings = mean_pooling(\n","                outputs,\n","                encoded[\"attention_mask\"]\n","            )\n","        embeddings.append(\n","            sentence_embeddings.cpu().numpy()\n","        )\n","    return np.vstack(embeddings)\n","\n","\n","# FEATURE EXTRACTION\n","X_train_features = extract_embeddings(X_train)\n","X_test_features = extract_embeddings(X_test)\n","print(\"=\" * 50)\n","print(\"HASIL FEATURE EXTRACTION INDOBERT BASE\")\n","print(\"=\" * 50)\n","print(\"X_train :\", X_train_features.shape)\n","print(\"X_test  :\", X_test_features.shape)"],"metadata":{"id":"h5n_zf2Ob8ep","executionInfo":{"status":"ok","timestamp":1783760285272,"user_tz":-420,"elapsed":16666,"user":{"displayName":"OGIK KODING","userId":"13433047210437248029"}},"colab":{"base_uri":"https://localhost:8080/","height":136,"referenced_widgets":["f70b8c3af9c14168a1abf74a65898353","93fc7b426e9242aaa7345325baae2f63","0a687854c0cb463b8aedaa83743d0d2a","52c6023441dd479dbe46cb5e5120ffdb","fec02dd6d47d440a9898a02156aa9e6f","b765825ab4944e36a3f1c326d1c66c47","475a84a4fc5c493b8e162ceee092e10e","bb19ce5eaf324e19a0cb31c8f0d0d8ad","5ff19e6c93b6474bb505b612103f7837","263be600cc32489c842443a75c011762","02bd9285a3024614812c1beecb6aa681"]},"outputId":"b9c8d2c6-c408-45f9-9112-d9c2167811e1"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f70b8c3af9c14168a1abf74a65898353"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["==================================================\n","HASIL FEATURE EXTRACTION INDOBERT BASE\n","==================================================\n","X_train : (4435, 768)\n","X_test  : (1109, 768)\n"]}]},{"cell_type":"code","source":["# TRAINING XGBOOST - MODEL JE