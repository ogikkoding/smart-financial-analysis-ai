      batch = texts.iloc[i:i+batch_size].astype(str).tolist()\n","        encoded = tokenizer(\n","            batch,\n","            padding=True,\n","            truncation=True,\n","            max_length=128,\n","            return_tensors=\"pt\"\n","        )\n","        encoded = {\n","            k: v.to(device)\n","            for k, v in encoded.items()\n","        }\n","        with torch.no_grad():\n","            outputs = bert_model(**encoded)\n","            sentence_embeddings = mean_pooling(\n","                outputs,\n","                encoded[\"attention_mask\"]\n","            )\n","        embeddings.append(\n","            sentence_embeddings.cpu().numpy()\n","        )\n","    return np.vstack(embeddings)\n","\n","\n","# FEATURE EXTRACTION\n","X_train_features = extract_embeddings(X_train)\n","X_test_features = extract_embeddings(X_test)\n","print(\"=\" * 50)\n","print(\"HASIL FEATURE EXTRACTION INDOBERT BASE\")\n","print(\"=\" * 50)\n","print(\"X_train :\", X_train_features.shape)\n","print(\"X_test  :\", X_test_features.shape)"],"metadata":{"id":"H5rEPeGMUhqX","executionInfo":{"status":"ok","timestamp":1783760048810,"user_tz":-420,"elapsed":14479,"user":{"displayName":"OGIK KODING","userId":"13433047210437248029"}},"colab":{"base_uri":"https://localhost:8080/","height":136,"referenced_widgets":["ba69d0057a164a9598df6f9159c8c63a","fe020be4e9454ee1aa10e3acadf08b9e","8faca79a25294f09bac8165f8fdbff95","941e8aa442284f608c17083f5f176fce","c03928cde7d14b4e9ede96607de5d40a","20cad198d2bb4b15ae90a6643e6e46b5","6a290c2b7e3447c5883cce8cc192d51f","1b0fbecb91e74b098ec930466ebfd7c5","29749748edd14767a6eb22bd5c020ce9","e73d1d75d9b3495789ad64cc9ed3a28b","5eca7d04275f43dd86ea713de8d4dd7c"]},"outputId":"7f14b1f9-baa0-4168-d17d-d75307ea0187"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Loading weights:   0%|          | 0/199 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_mi